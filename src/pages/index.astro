---
import '../styles/global.css';

const actions = [
  {
    eyebrow: 'INSTAGRAM',
    title: '@ecab.mx',
    caption: 'Ir a Instagram ↗',
    href: 'https://www.instagram.com/ecab.mx?igsh=cDhpeGoycWcyNHhm&utm_source=qr',
    icon: 'instagram',
  },
  {
    eyebrow: 'WHATSAPP',
    title: 'Hablemos',
    caption: 'Abrir chat ↗',
    href: 'https://wa.me/525532535233',
    icon: 'whatsapp',
  },
  {
    eyebrow: 'AGENDAR CLASE',
    title: 'Reserva tu lugar',
    caption: 'Agendar ahora ↗',
    href: '#agenda',
    icon: 'calendar',
    internal: true,
  },
  {
    eyebrow: 'CLUB BERIMBAU',
    title: 'Entrena con nosotros',
    caption: 'Ver ubicación ↗',
    href: 'https://maps.app.goo.gl/T1rkvCFSEc2844om8?g_st=ic',
    icon: 'location',
  },
];

const mantra = ['MENTE', 'CUERPO', 'DISCIPLINA', 'RESULTADOS'];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abdon Marín | Entrenador personalizado de natación, atletismo y triatlón</title>
    <meta name="description" content="Entrenamiento personalizado con S. Abdon Marín: natación, atletismo, triatlón y preparación multideportiva en Club Berimbau, Estado de México y en línea." />
    <meta name="keywords" content="entrenador de natación, entrenador de atletismo, entrenador de triatlón, entrenamiento personalizado, Club Berimbau, Estado de México, entrenamiento en línea" />
    <link rel="canonical" href="https://abdon.mx/" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#080b07" />
    <meta name="author" content="S. Abdon Marín" />
    <meta name="geo.region" content="MX-MEX" />
    <meta name="geo.placename" content="Club Berimbau, Estado de México" />
    <meta property="og:url" content="https://abdon.mx/" />
    <meta property="og:title" content="Abdon Marín | Entrenador personalizado multideportivo" />
    <meta property="og:description" content="Natación, atletismo, triatlón y preparación personalizada en Club Berimbau, Estado de México y en línea." />
    <meta property="og:image" content="https://abdon.mx/og.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="S. Abdon Marín, entrenador personalizado de natación, atletismo y triatlón" />
    <meta property="og:site_name" content="EcabMx" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content="profile" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Abdon Marín | Entrenador personalizado multideportivo" />
    <meta name="twitter:description" content="Natación, atletismo, triatlón y preparación personalizada en Club Berimbau, Estado de México y en línea." />
    <meta name="twitter:image" content="https://abdon.mx/og.jpg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'ProfilePage', '@id': 'https://abdon.mx/#page', url: 'https://abdon.mx/',
          name: 'Abdon Marín | Entrenador personalizado multideportivo', inLanguage: 'es-MX',
          mainEntity: { '@id': 'https://abdon.mx/#person' }, primaryImageOfPage: 'https://abdon.mx/og.jpg'
        },
        {
          '@type': 'WebSite', '@id': 'https://abdon.mx/#website', url: 'https://abdon.mx/', name: 'EcabMx',
          inLanguage: 'es-MX', publisher: { '@id': 'https://abdon.mx/#person' }
        },
        {
          '@type': 'Person', '@id': 'https://abdon.mx/#person', name: 'S. Abdon Marín', alternateName: 'EcabMx',
          jobTitle: 'Entrenador personalizado de natación, atletismo y triatlón',
          description: 'Entrenador multidisciplinario especializado en natación, atletismo, triatlón y preparación deportiva personalizada.',
          image: 'https://abdon.mx/assets/abdon-portrait.jpg', url: 'https://abdon.mx/', telephone: '+52-55-3253-5233',
          sameAs: ['https://www.instagram.com/ecab.mx'], knowsLanguage: 'es-MX',
          knowsAbout: ['Natación', 'Atletismo', 'Triatlón', 'Entrenamiento personalizado', 'Preparación multideportiva'],
          worksFor: { '@id': 'https://abdon.mx/#business' }, workLocation: { '@id': 'https://abdon.mx/#business' }
        },
        {
          '@type': ['LocalBusiness', 'SportsActivityLocation'], '@id': 'https://abdon.mx/#business',
          name: 'EcabMx — Entrenamiento con S. Abdon Marín', url: 'https://abdon.mx/', image: 'https://abdon.mx/og.jpg',
          telephone: '+52-55-3253-5233', priceRange: '$$', currenciesAccepted: 'MXN',
          description: 'Entrenamiento personalizado de natación, atletismo y triatlón en Club Berimbau, Estado de México, además de programas en línea.',
          areaServed: [{ '@type': 'AdministrativeArea', name: 'Estado de México' }, { '@type': 'Country', name: 'México' }],
          address: { '@type': 'PostalAddress', addressLocality: 'Club Berimbau', addressRegion: 'Estado de México', addressCountry: 'MX' },
          hasMap: 'https://maps.app.goo.gl/T1rkvCFSEc2844om8', sameAs: ['https://www.instagram.com/ecab.mx'],
          employee: { '@id': 'https://abdon.mx/#person' },
          hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Entrenamientos EcabMx', itemListElement: [
            { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Entrenamiento de natación', serviceType: 'Entrenamiento personalizado de natación' } },
            { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Entrenamiento de atletismo', serviceType: 'Entrenamiento personalizado de atletismo' } },
            { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Entrenamiento de triatlón', serviceType: 'Preparación personalizada de triatlón' } },
            { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Entrenamiento en línea', serviceType: 'Entrenamiento deportivo a distancia' } }
          ] }
        }
      ]
    })} />
    <style is:global>
      :root { --acid: #b7ff00; --ink: #080b07; }
      body { font-family: 'Archivo', Arial, sans-serif; }
      .portrait { object-position: 50% 38%; }
      @media (min-width: 1024px) { .portrait { object-position: 50% 34%; } }
      @media (prefers-reduced-motion: no-preference) {
        .action-card { transition: border-color .2s ease, background-color .2s ease, transform .2s ease; }
        .action-card:hover { transform: translateX(5px); border-color: var(--acid); background-color: rgb(8 11 7 / .86); }
      }
    </style>
  </head>
  <body class="min-h-screen bg-[var(--ink)] text-white">
    <main class="mx-auto grid min-h-screen w-full max-w-[1180px] gap-0 lg:grid-cols-[minmax(0,0.86fr)_minmax(0,1.14fr)] lg:items-start lg:gap-10 lg:px-6 lg:py-10">
      <section class="relative isolate flex min-h-[620px] flex-col justify-between overflow-hidden bg-[#11150f] px-6 py-8 sm:min-h-[700px] sm:px-10 lg:min-h-[850px] lg:rounded-[2rem] lg:px-12 lg:py-12" aria-labelledby="hero-title">
        <img class="portrait absolute inset-0 z-0 h-full w-full object-cover" src="/assets/abdon-portrait.jpg" alt="S. Abdon Marín, entrenador en una instalación deportiva" width="960" height="1280" fetchpriority="high" />
        <div class="absolute inset-0 z-10 bg-gradient-to-b from-black/80 via-black/20 to-black/85"></div>
        <div class="absolute inset-0 z-10 bg-gradient-to-r from-black/70 via-black/10 to-transparent"></div>

        <header class="relative z-20">
          <div class="mb-6 h-1 w-11 bg-[var(--acid)]"></div>
          <p class="text-5xl font-black tracking-[-0.08em] sm:text-6xl">Ecab<span class="text-[var(--acid)]">Mx</span></p>
          <div class="mt-6 h-px w-16 bg-[var(--acid)]"></div>
          <h1 id="hero-title" class="mt-5 text-2xl font-black tracking-tight sm:text-3xl">S. Abdon Marín</h1>
          <p class="mt-1 text-base text-white/75 sm:text-lg">Entrenador personalizado de natación, atletismo y triatlón</p>
        </header>

        <div class="relative z-20 my-12 border-l border-[var(--acid)] pl-8">
          {mantra.map((word, index) => <p class:list={['text-lg tracking-[0.28em] leading-[1.9]', index % 2 ? 'text-[var(--acid)]' : 'text-white/85']}>{word}</p>)}
        </div>

        <a class="group relative z-20 flex items-center gap-5 rounded-2xl border border-[var(--acid)]/80 bg-black/55 p-5 backdrop-blur-sm" href="https://wa.me/525532535233?text=Hola%20Abdon%2C%20me%20interesa%20recibir%20informaci%C3%B3n%20sobre%20entrenamientos%20en%20l%C3%ADnea%20EcabMx." target="_blank" rel="noopener">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg border border-[var(--acid)] text-2xl text-[var(--acid)]" aria-hidden="true">↗</span>
          <span><strong class="block text-sm tracking-[0.18em]">ENTRENAMIENTOS EN LÍNEA</strong><span class="mt-1 block text-sm text-white/75">Programas personalizados, seguimiento y resultados reales.</span></span>
        </a>
      </section>

      <section id="agenda" class="px-5 py-12 lg:px-0 lg:py-0" aria-label="Contacto y agenda de clases">
        <div class="mb-8"><p class="text-xs font-bold tracking-[0.35em] text-[var(--acid)]">ENTRENADOR PERSONALIZADO</p><h2 class="mt-3 text-4xl font-black leading-none tracking-tight sm:text-5xl">Natación,<br />atletismo,<br />triatlón<span class="text-[var(--acid)]"> y más.</span></h2><p class="mt-5 max-w-xl text-base leading-relaxed text-white/70">Soy S. Abdon Marín. Diseño entrenamientos a tu medida para mejorar tu técnica, rendimiento y condición física, en Club Berimbau o desde cualquier lugar en línea.</p></div>
        <div class="grid gap-3">
          {actions.map((action) => (
            <a class="action-card flex items-center gap-4 rounded-2xl border border-white/30 bg-white/[.04] px-5 py-4 backdrop-blur-sm" href={action.href} target={action.internal ? undefined : '_blank'} rel={action.internal ? undefined : 'noopener'}>
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-[var(--acid)] text-xl text-[var(--acid)]" aria-hidden="true">
                {action.icon === 'instagram' && '◎'}
                {action.icon === 'whatsapp' && '◉'}
                {action.icon === 'calendar' && '▦'}
                {action.icon === 'location' && '⌖'}
              </span>
              <span class="min-w-0 flex-1"><strong class="block text-xs tracking-[0.25em] text-white/90">{action.eyebrow}</strong><span class="mt-1 block text-base text-white/80">{action.title}</span><span class="mt-1 block text-xs text-[var(--acid)]">{action.caption}</span></span>
              <span class="text-3xl font-light text-[var(--acid)]" aria-hidden="true">›</span>
            </a>
          ))}
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border border-white/10 bg-white/[.03]" data-nadamas-widget data-cliente="hJ3lwzAlTkQkaMev2ro8Of129d83" data-theme="dark" data-title="Horarios EcabMx en nadamas.app"></div>
        <script src="https://nadamas.app/widget.js" async is:inline></script>

        <div class="mt-12 border-t border-white/10 pt-8 text-sm leading-relaxed text-white/65">
          <p class="text-xs font-bold tracking-[0.3em] text-[var(--acid)]">NATACIÓN · ATLETISMO · TRIATLÓN · MULTIDEPORTE</p>
          <p class="mt-4">Entrenamiento personalizado para niñas, niños, jóvenes y adultos: desde iniciación y técnica hasta preparación para competencias y alto rendimiento.</p>
          <p class="mt-4">Atención presencial en Club Berimbau, Estado de México, además de programas en línea · <a class="text-[var(--acid)] underline underline-offset-4" href="https://wa.me/525532535233" target="_blank" rel="noopener">WhatsApp +52 55 3253 5233</a></p>
        </div>
      </section>
    </main>
  </body>
</html>
